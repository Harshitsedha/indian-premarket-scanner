# Anthropic
ANTHROPIC_API_KEY=

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Port 8765 is dedicated to the one-time OAuth callback (upstox_auth.py) — never conflicts with API on 8000
UPSTOX_REDIRECT_URI=http://localhost:8765/callback
UPSTOX_ACCESS_TOKEN=       # populated by upstox_auth.py, then managed in DB
UPSTOX_REFRESH_TOKEN=      # populated by upstox_auth.py, then managed in DB
UPSTOX_EXTENDED_TOKEN=     # long-lived (~1 year) token; re-run upstox_auth.py annually

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Healthchecks
HEALTHCHECK_SCRAPER_URL=
HEALTHCHECK_ANALYSER_URL=
HEALTHCHECK_UPSTOX_REFRESH_URL=    # optional — pinged after each successful token refresh

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=premarket
POSTGRES_USER=premarket
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# App
APP_ENV=development         # development | production
LOG_LEVEL=INFO
DASHBOARD_PORT=3000
API_PORT=8000
