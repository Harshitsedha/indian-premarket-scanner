[Unit]
Description=PreMarket Pro — Intraday Radar Poller
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/premarket/pipeline
ExecStart=/opt/premarket/pipeline/.venv/bin/python realtime/radar_poller.py
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=radar-poller
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
